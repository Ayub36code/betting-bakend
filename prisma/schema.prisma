// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ───────────────────────────────────────────────────────────────────

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
  OPERATOR
}

enum BetStatus {
  PENDING
  ACCEPTED
  REJECTED
  WON
  LOST
  VOID
  CASHED_OUT
  CANCELLED
  SUSPENDED
}

enum BetType {
  SINGLE
  MULTI
  SYSTEM
}

enum MarketStatus {
  OPEN
  SUSPENDED
  CLOSED
  SETTLED
  CANCELLED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BET_PLACEMENT
  BET_WIN
  BET_REFUND
  CASHOUT
  BONUS
  ADJUSTMENT
  ROLLBACK
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  ROLLED_BACK
}

enum OddsFormat {
  DECIMAL
  FRACTIONAL
  AMERICAN
}

enum EventStatus {
  UPCOMING
  LIVE
  FINISHED
  CANCELLED
  POSTPONED
}

// ─── MODELS ──────────────────────────────────────────────────────────────────

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  username          String    @unique
  passwordHash      String
  role              Role      @default(USER)
  isActive          Boolean   @default(true)
  isVerified        Boolean   @default(false)
  kycVerified       Boolean   @default(false)
  phoneNumber       String?
  firstName         String?
  lastName          String?
  dateOfBirth       DateTime?
  country           String?
  timezone          String    @default("UTC")
  maxBetAmount      Decimal   @default(10000) @db.Decimal(18, 2)
  maxDailyLoss      Decimal   @default(50000) @db.Decimal(18, 2)
  maxExposure       Decimal   @default(100000) @db.Decimal(18, 2)
  selfExcludedUntil DateTime?
  loginAttempts     Int       @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  refreshToken      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  wallet       Wallet?
  bets         Bet[]
  transactions Transaction[]
  sessions     UserSession[]
  auditLogs    AuditLog[]
  bookings     Booking[]

  @@index([email])
  @@index([username])
}

model UserSession {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  ipAddress String?
  userAgent String?
  isActive  Boolean  @default(true)
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Wallet {
  id              String   @id @default(uuid())
  userId          String   @unique
  balance         Decimal  @default(0) @db.Decimal(18, 2)
  bonusBalance    Decimal  @default(0) @db.Decimal(18, 2)
  reservedBalance Decimal  @default(0) @db.Decimal(18, 2) // funds locked in pending bets
  currency        String   @default("USD")
  version         Int      @default(0) // optimistic locking
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id             String            @id @default(uuid())
  userId         String
  walletId       String
  type           TransactionType
  status         TransactionStatus @default(PENDING)
  amount         Decimal           @db.Decimal(18, 2)
  balanceBefore  Decimal           @db.Decimal(18, 2)
  balanceAfter   Decimal           @db.Decimal(18, 2)
  referenceId    String? // bet id, cashout id etc
  referenceType  String?
  description    String?
  metadata       Json?
  idempotencyKey String?           @unique
  rolledBackAt   DateTime?
  rollbackTxId   String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  wallet Wallet @relation(fields: [walletId], references: [id])
  Bet    Bet[]  @relation("BetTransactions")

  @@index([userId])
  @@index([walletId])
  @@index([referenceId])
  @@index([idempotencyKey])
}

model Sport {
  id        String   @id @default(uuid())
  name      String   @unique
  slug      String   @unique
  icon      String?
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events Event[]
}

model Event {
  id        String      @id @default(uuid())
  sportId   String
  name      String
  slug      String
  homeTeam  String?
  awayTeam  String?
  startTime DateTime
  endTime   DateTime?
  status    EventStatus @default(UPCOMING)
  isLive    Boolean     @default(false)
  score     Json? // { home: 0, away: 0 }
  metadata  Json?
  streamUrl String?
  venueId   String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  sport   Sport    @relation(fields: [sportId], references: [id])
  markets Market[]

  @@index([sportId])
  @@index([startTime])
  @@index([status])
}

model Market {
  id              String       @id @default(uuid())
  eventId         String
  name            String
  type            String // MATCH_WINNER, OVER_UNDER, BOTH_TEAMS_SCORE, etc.
  status          MarketStatus @default(OPEN)
  isSuspended     Boolean      @default(false)
  suspendedReason String?
  maxBetAmount    Decimal      @default(10000) @db.Decimal(18, 2)
  minBetAmount    Decimal      @default(1) @db.Decimal(18, 2)
  maxExposure     Decimal      @default(500000) @db.Decimal(18, 2)
  currentExposure Decimal      @default(0) @db.Decimal(18, 2)
  cutoffTime      DateTime?
  metadata        Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  selections Selection[]

  @@index([eventId])
  @@index([status])
}

model Selection {
  id           String   @id @default(uuid())
  marketId     String
  name         String // Home Win, Draw, Away Win
  code         String? // H, D, A
  odds         Decimal  @db.Decimal(10, 4)
  lockedOdds   Decimal? @db.Decimal(10, 4) // odds at bet placement
  isWinner     Boolean?
  isSuspended  Boolean  @default(false)
  runnerNumber Int?
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  market        Market         @relation(fields: [marketId], references: [id], onDelete: Cascade)
  betSelections BetSelection[]
  oddsHistory   OddsHistory[]

  @@index([marketId])
}

model OddsHistory {
  id          String   @id @default(uuid())
  selectionId String
  oldOdds     Decimal  @db.Decimal(10, 4)
  newOdds     Decimal  @db.Decimal(10, 4)
  changedBy   String?
  reason      String?
  createdAt   DateTime @default(now())

  selection Selection @relation(fields: [selectionId], references: [id], onDelete: Cascade)

  @@index([selectionId])
}

model Bet {
  id                  String    @id @default(uuid())
  userId              String
  betRef              String    @unique // human-readable reference
  type                BetType   @default(SINGLE)
  status              BetStatus @default(PENDING)
  stake               Decimal   @db.Decimal(18, 2)
  potentialWin        Decimal   @db.Decimal(18, 2)
  actualWin           Decimal?  @db.Decimal(18, 2)
  totalOdds           Decimal   @db.Decimal(10, 4)
  bonusUsed           Decimal   @default(0) @db.Decimal(18, 2)
  cashoutValue        Decimal?  @db.Decimal(18, 2)
  cashoutOdds         Decimal?  @db.Decimal(10, 4)
  cashoutAt           DateTime?
  isPartialCashout    Boolean   @default(false)
  partialCashoutStake Decimal?  @db.Decimal(18, 2)
  bookingCode         String?   @unique
  ipAddress           String?
  userAgent           String?
  acceptAnyOdds       Boolean   @default(false)
  oddsChangePolicy    String    @default("REJECT") // REJECT | ACCEPT_BETTER | ACCEPT_ANY
  systemBetDetails    Json? // for system bets (2/3, 3/4 etc.)
  settledAt           DateTime?
  voidedAt            DateTime?
  voidReason          String?
  metadata            Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user         User           @relation(fields: [userId], references: [id])
  selections   BetSelection[]
  transactions Transaction[]  @relation("BetTransactions")
  cashouts     Cashout[]

  @@index([userId])
  @@index([status])
  @@index([betRef])
  @@index([bookingCode])
  @@index([createdAt])
}

model BetSelection {
  id          String   @id @default(uuid())
  betId       String
  selectionId String
  marketId    String
  eventId     String
  odds        Decimal  @db.Decimal(10, 4) // odds at placement
  isSettled   Boolean  @default(false)
  isWinner    Boolean?
  voidReason  String?
  metadata    Json?
  createdAt   DateTime @default(now())

  bet       Bet       @relation(fields: [betId], references: [id], onDelete: Cascade)
  selection Selection @relation(fields: [selectionId], references: [id])

  @@index([betId])
  @@index([selectionId])
}

model Cashout {
  id             String   @id @default(uuid())
  betId          String
  userId         String
  amount         Decimal  @db.Decimal(18, 2)
  isPartial      Boolean  @default(false)
  partialStake   Decimal? @db.Decimal(18, 2)
  remainingStake Decimal? @db.Decimal(18, 2)
  oddsAtCashout  Decimal  @db.Decimal(10, 4)
  status         String   @default("COMPLETED")
  createdAt      DateTime @default(now())

  bet Bet @relation(fields: [betId], references: [id])

  @@index([betId])
  @@index([userId])
}

model Booking {
  id         String   @id @default(uuid())
  code       String   @unique
  userId     String?
  selections Json // array of selectionIds + odds
  totalOdds  Decimal  @db.Decimal(10, 4)
  isExpired  Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([code])
}

model RiskProfile {
  id               String   @id @default(uuid())
  userId           String   @unique
  riskScore        Int      @default(0) // 0-100
  totalBets        Int      @default(0)
  totalStaked      Decimal  @default(0) @db.Decimal(18, 2)
  totalWon         Decimal  @default(0) @db.Decimal(18, 2)
  totalLost        Decimal  @default(0) @db.Decimal(18, 2)
  winRate          Decimal  @default(0) @db.Decimal(5, 2)
  avgOdds          Decimal  @default(0) @db.Decimal(10, 4)
  biggestWin       Decimal  @default(0) @db.Decimal(18, 2)
  dailyStaked      Decimal  @default(0) @db.Decimal(18, 2)
  weeklyStaked     Decimal  @default(0) @db.Decimal(18, 2)
  monthlyStaked    Decimal  @default(0) @db.Decimal(18, 2)
  flaggedForReview Boolean  @default(false)
  reviewReason     String?
  lastUpdated      DateTime @updatedAt
  createdAt        DateTime @default(now())

  @@index([userId])
  @@index([riskScore])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  category  String   @default("GENERAL")
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([category])
}
